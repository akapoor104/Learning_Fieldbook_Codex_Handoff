            }
          },
          "403": {
            "description": "Actor cannot perform this action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale expected revision or idempotency-key mismatch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid inputs or links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "signal": {
                    "type": "string",
                    "enum": [
                      "matched",
                      "missed",
                      "unclear",
                      "worked",
                      "needs_change"
                    ]
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "behavior": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "learning": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "unexpected_setback": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "pride": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "uniqueItems": true
                  },
                  "corrects_observation_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "expected_revision",
                  "signal",
                  "occurred_at",
                  "behavior",
                  "learning"
                ]
              }
            }
          }
        }
      }
    },
